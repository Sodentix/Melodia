# Melodia Backend – copy to .env and fill in values. Never commit .env.

# Server
PORT=5000
HOST=0.0.0.0

# CORS – comma-separated allowed origins (required in production)
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/melodia

# Authentication (JWT_SECRET must be set in production, min 16 characters)
JWT_SECRET=your-secret-at-least-16-chars
JWT_EXPIRES_IN=7d
PASSWORD_HISTORY_LIMIT=5

# Login rate limiting (brute-force protection)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_MS=900000

# Email (e.g. Gmail SMTP)
EMAIL_USER=
EMAIL_PASSWORD=
BACKEND_URL=http://localhost:5000
# Frontend base URL for email links (e.g. verify-email). Fallback: BACKEND_URL
FRONTEND_URL=http://localhost:5173

# Audit log retention (days). Logs older than this are deleted by cleanup script. Default: 90
AUDIT_LOG_RETENTION_DAYS=90

# Optional: logging and game
NODE_ENV=development
DEBUG_GAME=false
GAME_ROUND_TTL_MS=300000
LOG_LEVEL=info
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_HEADERS=false
