# Copy to backend/.env and fill in real values for deployment
# For Cloudflare Tunnel: use your tunnel domain for CORS_ORIGIN and FRONTEND_URL
# MONGODB_URI is overridden by docker-compose when using the included MongoDB container

PORT=5001
HOST=0.0.0.0
CORS_ORIGIN=https://your-app.your-domain.com
# MONGODB_URI - not needed with docker-compose (uses MongoDB container)
JWT_SECRET=your-strong-secret-at-least-16-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://your-app.your-domain.com
BACKEND_URL=https://your-app.your-domain.com
EMAIL_USER=
EMAIL_PASSWORD=

# Optional: Spotify integration
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_MARKET=US
